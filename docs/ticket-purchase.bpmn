<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="TheaterDefinitions" targetNamespace="https://example.org/theater-ticketing"><bpmn:collaboration id="Collaboration"><bpmn:participant id="Pool" name="Оформление учебного билета" processRef="Purchase" /></bpmn:collaboration><bpmn:process id="Purchase" isExecutable="false"><bpmn:documentation>Фактическая версия портфолио. Авторизация выполнена до старта. Выдача без оплаты. Транзакция атомарна; при ошибке все изменения откатываются.</bpmn:documentation><bpmn:laneSet id="Lanes"><bpmn:lane id="Client" name="Зритель"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Choose</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="System" name="Приложение и PostgreSQL"><bpmn:flowNodeRef>Issue</bpmn:flowNodeRef><bpmn:flowNodeRef>Result</bpmn:flowNodeRef><bpmn:flowNodeRef>Success</bpmn:flowNodeRef><bpmn:flowNodeRef>Failure</bpmn:flowNodeRef><bpmn:flowNodeRef>Done</bpmn:flowNodeRef><bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Начало" /><bpmn:userTask id="Choose" name="Выбрать показ и категорию" /><bpmn:userTask id="Confirm" name="Подтвердить оформление" /><bpmn:serviceTask id="Issue" name="Проверить доступ и выполнить транзакцию" /><bpmn:exclusiveGateway id="Result" name="Результат" /><bpmn:serviceTask id="Success" name="Показать билет и новый остаток" /><bpmn:serviceTask id="Failure" name="Показать причину отказа без изменений" /><bpmn:endEvent id="Done" name="Билет оформлен" /><bpmn:endEvent id="Rejected" name="Билет не создан" /><bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="Choose" name="" /><bpmn:sequenceFlow id="f2" sourceRef="Choose" targetRef="Confirm" name="" /><bpmn:sequenceFlow id="f3" sourceRef="Confirm" targetRef="Issue" name="" /><bpmn:sequenceFlow id="f4" sourceRef="Issue" targetRef="Result" name="" /><bpmn:sequenceFlow id="f5" sourceRef="Result" targetRef="Success" name="Успех" /><bpmn:sequenceFlow id="f6" sourceRef="Result" targetRef="Failure" name="Отказ / ошибка" /><bpmn:sequenceFlow id="f7" sourceRef="Success" targetRef="Done" name="" /><bpmn:sequenceFlow id="f8" sourceRef="Failure" targetRef="Rejected" name="" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration"><bpmndi:BPMNShape id="Pool_shape" bpmnElement="Pool" isHorizontal="true"><dc:Bounds x="35" y="65" width="1260" height="480" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Client_shape" bpmnElement="Client" isHorizontal="true"><dc:Bounds x="65" y="65" width="1230" height="190" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="System_shape" bpmnElement="System" isHorizontal="true"><dc:Bounds x="65" y="255" width="1230" height="290" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_shape" bpmnElement="Start"><dc:Bounds x="100" y="140" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Choose_shape" bpmnElement="Choose"><dc:Bounds x="180" y="120" width="150" height="75" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Confirm_shape" bpmnElement="Confirm"><dc:Bounds x="380" y="120" width="150" height="75" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Issue_shape" bpmnElement="Issue"><dc:Bounds x="580" y="320" width="190" height="85" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Result_shape" bpmnElement="Result"><dc:Bounds x="840" y="335" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Success_shape" bpmnElement="Success"><dc:Bounds x="960" y="290" width="165" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Failure_shape" bpmnElement="Failure"><dc:Bounds x="960" y="420" width="165" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Done_shape" bpmnElement="Done"><dc:Bounds x="1200" y="307" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Rejected_shape" bpmnElement="Rejected"><dc:Bounds x="1200" y="437" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="f1_edge" bpmnElement="f1"><di:waypoint x="136" y="158" /><di:waypoint x="180" y="158" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f2_edge" bpmnElement="f2"><di:waypoint x="330" y="158" /><di:waypoint x="380" y="158" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f3_edge" bpmnElement="f3"><di:waypoint x="530" y="158" /><di:waypoint x="675" y="158" /><di:waypoint x="675" y="320" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f4_edge" bpmnElement="f4"><di:waypoint x="770" y="362" /><di:waypoint x="840" y="362" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f5_edge" bpmnElement="f5"><di:waypoint x="890" y="360" /><di:waypoint x="925" y="360" /><di:waypoint x="925" y="325" /><di:waypoint x="960" y="325" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f6_edge" bpmnElement="f6"><di:waypoint x="865" y="385" /><di:waypoint x="865" y="455" /><di:waypoint x="960" y="455" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f7_edge" bpmnElement="f7"><di:waypoint x="1125" y="325" /><di:waypoint x="1200" y="325" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f8_edge" bpmnElement="f8"><di:waypoint x="1125" y="455" /><di:waypoint x="1200" y="455" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>